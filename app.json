{
  "expo": {
    "name": "Gallery Sweeper",
    "slug": "GallerySweeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to help you clean them up.",
        "PHPhotoLibraryPreventAutomaticLimitedAccessAlert": "false",
        "NSSupportsLiveActivities": true
      },
      "bundleIdentifier": "com.francescocipolla.GallerySweeper",
      "appleTeamId": "W4FRQQ45TL"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.francescocipolla.GallerySweeper"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-background-task",
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.1"
          }
        }
      ]
    ]
  }
}
